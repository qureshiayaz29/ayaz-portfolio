---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
---

<Base
  title="Page not found — Ayaz Qureshi"
  description="This page doesn't exist."
  canonical="/"
  noindex={true}
>
  <Nav />

  <main id="content" class="max-w-3xl mx-auto px-6" style="min-height:70vh; display:flex; flex-direction:column; justify-content:center;">
    <p style="font-family:'DM Mono',monospace; font-size:12px; text-transform:uppercase; letter-spacing:0.1em; color:#8a8a8a;">
      Error 404
    </p>
    <h1 style="font-family:'Instrument Serif',serif; font-size:clamp(2.6rem,7vw,4rem); line-height:1.05; color:#f0f0f0; margin-top:14px;">
      Nothing <em style="font-style:italic; color:#1D9E75;">here.</em>
    </h1>
    <p style="font-family:'Geist',sans-serif; font-size:16px; color:#9c9c9c; max-width:46ch; line-height:1.75; margin-top:18px;">
      The page you're looking for doesn't exist or has moved.
    </p>
    <div class="flex flex-wrap gap-3" style="margin-top:28px;">
      <a href="/" class="nf-btn nf-btn-primary">Go home</a>
      <a href="/projects" class="nf-btn">See projects</a>
    </div>
  </main>

  <style>
    .nf-btn {
      font-family: 'Geist', sans-serif;
      font-size: 14px;
      font-weight: 500;
      border: 1px solid #2e2e2e;
      border-radius: 9999px;
      padding: 9px 20px;
      color: #d4d4d4;
      text-decoration: none;
      transition: background 0.15s, border-color 0.15s;
    }
    .nf-btn:hover { background: #1a1a1a; border-color: #3a3a3a; }
    .nf-btn-primary { background: #1D9E75; border-color: #1D9E75; color: #0c0c0c; }
    .nf-btn-primary:hover { background: #22b585; border-color: #22b585; }
  </style>
</Base>
