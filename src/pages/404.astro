---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
---

<Base
  title="Page not found — Ayaz Qureshi"
  description="This page doesn't exist."
  canonical="/"
  noindex={true}
>
  <Nav />

  <main id="content" class="max-w-3xl mx-auto px-6" style="min-height:70vh; display:flex; flex-direction:column; justify-content:center;">
    <p style="font-family:'JetBrains Mono',monospace; font-size:12px; text-transform:uppercase; letter-spacing:0.1em; color:#8B94A3;">
      Error 404
    </p>
    <h1 style="font-family:'JetBrains Mono', monospace; font-size:clamp(2.2rem,6vw,3.4rem); font-weight:800; letter-spacing:-0.045em; line-height:1.08; color:#E4E8EE; margin-top:14px;">
      Nothing <span style="color:#FFB020;white-space:nowrap;">here.<span class="term-cursor" aria-hidden="true"></span></span>
    </h1>
    <p style="font-family:'IBM Plex Sans',sans-serif; font-size:16px; color:#9AA3B2; max-width:46ch; line-height:1.75; margin-top:18px;">
      The page you're looking for doesn't exist or has moved.
    </p>
    <div class="flex flex-wrap gap-3" style="margin-top:28px;">
      <a href="/" class="nf-btn nf-btn-primary">Go home</a>
      <a href="/projects" class="nf-btn">See projects</a>
    </div>
  </main>

  <style>
    .nf-btn {
      font-family: 'IBM Plex Sans', sans-serif;
      font-size: 14px;
      font-weight: 500;
      border: 1px solid #323845;
      border-radius: 9999px;
      padding: 9px 20px;
      color: #C9D0DA;
      text-decoration: none;
      transition: background 0.15s, border-color 0.15s;
    }
    .nf-btn:hover { background: #1E2129; border-color: #3F4757; }
    .nf-btn-primary { background: #FFB020; border-color: #FFB020; color: #14161B; }
    .nf-btn-primary:hover { background: #FFC24D; border-color: #FFC24D; }
  </style>
</Base>
