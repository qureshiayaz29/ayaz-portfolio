---
// Shared shell for /mood-reactions/* pages: site nav, product sub-nav, and a seller footer.
import Base from './Base.astro';
import Nav from '../components/Nav.astro';
import { MR } from '../data/moodReactions';

interface Props {
  title: string;
  description: string;
  canonical: string;
}
const { title, description, canonical } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '');
const links = [
  { href: '/mood-reactions', label: 'Overview' },
  { href: '/mood-reactions/privacy', label: 'Privacy' },
  { href: '/mood-reactions/terms', label: 'Terms' },
  { href: '/mood-reactions/refund', label: 'Refunds' },
];
---

<Base title={title} description={description} canonical={canonical}>
  <Nav />
  <nav class="mr-subnav" aria-label="Mood Reactions">
    <div class="max-w-3xl mx-auto px-6 flex items-center gap-1 overflow-x-auto">
      <span class="mr-brand">Mood Reactions</span>
      {links.map((l) => (
        <a href={l.href} class:list={['mr-tab', { active: path === l.href }]} aria-current={path === l.href ? 'page' : undefined}>{l.label}</a>
      ))}
    </div>
  </nav>

  <main id="content" class="max-w-3xl mx-auto px-6 pt-12 pb-20">
    <slot />
  </main>

  <footer class="mr-footer">
    <div class="max-w-3xl mx-auto px-6 py-8 flex flex-col sm:flex-row gap-3 sm:items-center sm:justify-between">
      <p>Sold by {MR.seller}, {MR.sellerCountry}. Payments by Dodo Payments, merchant of record.</p>
      <p><a href={`mailto:${MR.supportEmail}`}>{MR.supportEmail}</a></p>
    </div>
  </footer>
</Base>

<style is:global>
  .mr-subnav { border-bottom: 1px solid #22262E; background: rgba(20,22,27,0.7); }
  .mr-brand { font-family: 'JetBrains Mono', monospace; font-size: 12px; color: #FFB020; letter-spacing: .06em; text-transform: uppercase; margin-right: 12px; white-space: nowrap; }
  @media (max-width: 480px) { .mr-brand { display: none; } }
  .mr-tab { font-family: 'IBM Plex Sans', sans-serif; font-size: 14px; color: #9AA3B2; text-decoration: none; padding: 12px 10px; border-bottom: 2px solid transparent; white-space: nowrap; transition: color .15s; }
  .mr-tab:hover { color: #C9D0DA; }
  .mr-tab.active { color: #E4E8EE; border-bottom-color: #FFB020; }
  .mr-footer { border-top: 1px solid #22262E; font-family: 'IBM Plex Sans', sans-serif; font-size: 13px; color: #9AA3B2; }
  .mr-footer a { color: #A9B1BE; }
  .mr-footer a:hover { color: #FFB020; }

  /* Long-form policy text */
  .mr-prose { font-family: 'IBM Plex Sans', sans-serif; font-size: 16px; line-height: 1.7; color: #C9D0DA; }
  .mr-prose h1 { font-family: 'JetBrains Mono', monospace; font-weight: 800; letter-spacing: -0.04em; font-size: clamp(30px, 5vw, 40px); line-height: 1.1; color: #E4E8EE; margin: 0 0 8px; }
  .mr-prose .updated { font-family: 'JetBrains Mono', monospace; font-size: 12px; color: #9AA3B2; margin: 0 0 36px; }
  .mr-prose h2 { font-family: 'IBM Plex Sans', sans-serif; font-weight: 500; font-size: 19px; color: #E4E8EE; margin: 40px 0 10px; }
  .mr-prose p { margin: 0 0 14px; }
  .mr-prose ul { margin: 0 0 14px; padding-left: 20px; list-style: disc; }
  .mr-prose li { margin: 4px 0; }
  .mr-prose li::marker { color: #FFB020; }
  .mr-prose a { color: #FFB020; text-underline-offset: 3px; }
  .mr-prose strong { color: #E4E8EE; font-weight: 500; }
  .mr-prose .callout { border: 1px solid #2B303A; background: #1B1E25; border-radius: 14px; padding: 16px 18px; margin: 0 0 28px; }
</style>
