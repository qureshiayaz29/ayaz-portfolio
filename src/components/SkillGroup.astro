---
interface Props {
  title: string;
  tags: string[];
  context: string;
  borderColor?: string;
  tagBg?: string;
  tagColor?: string;
}
const {
  title,
  tags,
  context,
  borderColor = '#3A4150',
  tagBg = '#22262E',
  tagColor = '#A9B1BE'
} = Astro.props;
---

<div class="skill-card" style={`border:1px solid #2B303A; border-left:3px solid ${borderColor}; border-radius:12px; padding:20px; background:#1B1E25;`}>
  <h3 style="font-family:'IBM Plex Sans',sans-serif; font-size:15px; font-weight:500; color:#E4E8EE; margin:0;">{title}</h3>
  <div class="flex flex-wrap gap-1.5 mt-3">
    {tags.map(tag => (
      <span style={`font-family:'JetBrains Mono',monospace; font-size:12px; background:${tagBg}; color:${tagColor}; padding:3px 9px; border-radius:4px; font-weight:500;`}>{tag}</span>
    ))}
  </div>
  <p style="font-family:'IBM Plex Sans',sans-serif; font-size:14px; color:#9AA3B2; margin-top:14px; line-height:1.65;">{context}</p>
</div>
