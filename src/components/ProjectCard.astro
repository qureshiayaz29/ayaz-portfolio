---
import type { ProjectStatus } from '../data/projects';

interface Props {
  name: string;
  cat: string;
  catLabel: string;
  status: ProjectStatus;
  desc: string;
  what: string;
  stack: string;
  next?: string;
  link?: string;
  image?: string;
  imageAlt?: string;
  featured?: boolean;
}

const { name, cat, catLabel, status, desc, what, stack, next, link, image, imageAlt = '', featured = false } = Astro.props;

const badge: Record<ProjectStatus, { bg: string; color: string; label: string }> = {
  live:     { bg: '#2E2208', color: '#FFB020', label: 'live' },
  progress: { bg: '#16213A', color: '#7AA2F7', label: 'in progress' },
  experiment: { bg: '#1e1b3a', color: '#a5b4fc', label: 'experiment' },
  idea:     { bg: '#22262E', color: '#9AA3B2', label: 'idea' },
};
const b = badge[status];
const stackTags = stack.split('·').map(s => s.trim()).filter(Boolean);
const isExternal = !!link && /^https?:\/\//.test(link);
const CONTACT_EMAIL = 'qureshi.ayaz29@gmail.com';
const discussHref = `mailto:${CONTACT_EMAIL}?subject=${encodeURIComponent(`Let's discuss: ${name}`)}`;
---

{featured ? (
  <a
    href="/projects"
    style="display:block; border:1px solid #2B303A; border-radius:12px; padding:20px; background:#1B1E25; text-decoration:none; transition:border-color 0.15s;"
    onmouseover="this.style.borderColor='#3A4150'"
    onmouseout="this.style.borderColor='#2B303A'"
  >
    {image && <img class="card-img" src={image} alt={imageAlt} width="1280" height="800" loading="lazy" decoding="async" />}
    <div class="flex items-start justify-between gap-3">
      <span style="font-family:'IBM Plex Sans',sans-serif; font-size:15px; font-weight:500; color:#E4E8EE;">{name}</span>
      <span style={`background:${b.bg}; color:${b.color}; font-family:'JetBrains Mono',monospace; font-size:11px; padding:3px 8px; border-radius:4px; white-space:nowrap; flex-shrink:0;`}>{b.label}</span>
    </div>
    <p style="font-family:'JetBrains Mono',monospace; font-size:12px; color:#8B94A3; margin-top:5px;">{catLabel}</p>
    <p style="font-family:'IBM Plex Sans',sans-serif; font-size:14px; color:#9AA3B2; margin-top:10px; line-height:1.65;">{desc}</p>
    <div class="flex flex-wrap gap-2 mt-3">
      {stackTags.map(tag => (
        <span style="font-family:'JetBrains Mono',monospace; font-size:12px; color:#8B94A3;">{tag}</span>
      ))}
    </div>
  </a>
) : (
  <div
    class="proj-card expandable-card"
    data-cat={cat}
    style="border:1px solid #2B303A; border-radius:12px; padding:20px; background:#1B1E25; cursor:pointer; transition:border-color 0.15s;"
    onmouseover="this.style.borderColor='#3A4150'"
    onmouseout="this.style.borderColor='#2B303A'"
  >
    {image && <img class="card-img" src={image} alt={imageAlt} width="1280" height="800" loading="lazy" decoding="async" />}
    <div class="flex items-start justify-between gap-3">
      <span style="font-family:'IBM Plex Sans',sans-serif; font-size:15px; font-weight:500; color:#E4E8EE; flex:1; min-width:0;">{name}</span>
      <div class="flex items-center gap-2 flex-shrink-0">
        <span style={`background:${b.bg}; color:${b.color}; font-family:'JetBrains Mono',monospace; font-size:11px; padding:3px 8px; border-radius:4px; white-space:nowrap;`}>{b.label}</span>
        <button type="button" class="expand-toggle" aria-expanded="false" aria-label={`Show details: ${name}`}>
          <span class="expand-icon" aria-hidden="true"></span>
        </button>
      </div>
    </div>
    <p style="font-family:'JetBrains Mono',monospace; font-size:12px; color:#8B94A3; margin-top:5px;">{catLabel}</p>
    <p style="font-family:'IBM Plex Sans',sans-serif; font-size:14px; color:#9AA3B2; margin-top:10px; line-height:1.65;">{desc}</p>
    <div class="flex flex-wrap gap-2 mt-3">
      {stackTags.map(tag => (
        <span style="font-family:'JetBrains Mono',monospace; font-size:12px; color:#8B94A3;">{tag}</span>
      ))}
    </div>
    {status === 'idea' && (
      <a href={discussHref} class="discuss-btn" aria-label={`Email Ayaz to discuss ${name}`}>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="2" y="4" width="20" height="16" rx="2"/>
          <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
        </svg>
        Discuss
      </a>
    )}
    <div class="detail" style="margin-top:18px; padding-top:18px; border-top:1px solid #22262E;">
      <p style="font-family:'IBM Plex Sans',sans-serif; font-size:14px; color:#A9B1BE; line-height:1.65;">{what}</p>
      {next && (
        <p style="font-family:'JetBrains Mono',monospace; font-size:12px; color:#8B94A3; margin-top:12px;">next → {next}</p>
      )}
      {link && (
        <a
          href={link}
          target={isExternal ? '_blank' : undefined}
          rel={isExternal ? 'noopener noreferrer' : undefined}
          class="link-in-card"
          style="display:inline-block; margin-top:14px; font-family:'JetBrains Mono',monospace; font-size:13px; color:#FFB020; text-decoration:none;"
        >link →</a>
      )}
    </div>
  </div>
)}

<style>
  .card-img {
    display: block;
    width: calc(100% + 40px);
    max-width: none;
    height: auto;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    margin: -20px -20px 16px;
    border-radius: 11px 11px 0 0;
    border-bottom: 1px solid #2B303A;
  }
  .discuss-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: 14px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
    color: #FFB020;
    border: 1px solid rgba(255,176,32,0.4);
    border-radius: 9999px;
    padding: 5px 12px;
    text-decoration: none;
    transition: background 0.15s, border-color 0.15s;
  }
  .discuss-btn:hover { background: rgba(255,176,32,0.1); border-color: #FFB020; }
</style>
